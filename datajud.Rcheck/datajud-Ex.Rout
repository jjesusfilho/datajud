> ##D 
> ##D # Search using query string
> ##D results <- search_advanced(
> ##D   tribunal = "trf1",
> ##D   query_string = "ação civil pública",
> ##D   fields = c("classe.nome", "assuntos.nome")
> ##D )
> ## End(Not run)
